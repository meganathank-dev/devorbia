    {
      "key": "startDate",
      "value": "",
      "type": "string"
    },
    {
      "key": "dueDate",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Requested-With",
                "value": "DevOrbia"
              }
            ],
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "Sign in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Requested-With",
                "value": "DevOrbia"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf}}"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json().data;",
                  "  pm.collectionVariables.set(\"csrf\", data.csrf);",
                  "  pm.collectionVariables.set(\"employeeId\", data.user.employeeId || \"\");",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Current identity",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Requested-With",
                "value": "DevOrbia"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Refresh session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Requested-With",
                "value": "DevOrbia"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf}}"
              }
            ],
            "url": "{{baseUrl}}/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Request recovery",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Requested-With",
                "value": "DevOrbia"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf}}"
              }
            ],
            "url": "{{baseUrl}}/auth/forgot-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Sign out",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Requested-With",
                "value": "DevOrbia"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf}}"
              }
            ],
            "url": "{{baseUrl}}/auth/logout",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
