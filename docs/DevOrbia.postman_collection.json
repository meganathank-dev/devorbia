{
  "info": {
    "name": "DevOrbia API",
    "description": "Cookie-based API starter. Set email/password locally, sign in, and use the same Postman cookie jar. Fill date/record variables with eligible test data. PATCH revisions must match the latest record. Role restrictions apply; switch accounts deliberately. Management requests change data: execute individually on a test database. See docs/API.md for the complete reference.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api/v1",
      "type": "string"
    },
    {
      "key": "email",
      "value": "",
      "type": "string"
    },
    {
      "key": "password",
      "value": "",
      "type": "string"
    },
    {
      "key": "csrf",
      "value": "",
      "type": "string"
    },
    {
      "key": "organizationId",
      "value": "",
      "type": "string"
    },
    {
      "key": "departmentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "teamId",
      "value": "",
      "type": "string"
    },
    {
      "key": "managerId",
      "value": "",
      "type": "string"
    },
    {
      "key": "employeeId",
