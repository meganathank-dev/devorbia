NODE_ENV=development
HOST=127.0.0.1
PORT=4000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/devorbia?replicaSet=devorbia
# npm run setup generates this secret. Never use this placeholder.
APP_SECRET=GENERATE_WITH_NPM_RUN_SETUP
TRUST_PROXY=0
MAIL_TRANSPORT=file
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=DevOrbia <no-reply@example.test>
SUPER_ADMIN_EMAIL=platform@example.test
SUPER_ADMIN_NAME=Platform Administrator
# Supply a unique password of at least 12 characters before npm run bootstrap.
SUPER_ADMIN_PASSWORD=
AI_PROVIDER=rules
JOBS_ENABLED=true
ANALYSIS_TASK_LIMIT=3000
# Optional, required only for npm run test:integration. Use a development replica set.
# The test runner creates and removes a uniquely named devorbia_test_* database.
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/devorbia_test?replicaSet=devorbia
